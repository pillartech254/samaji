# Assets have no cache-busting (no build step, no content-hashed
# filenames) — every deploy overwrites the same URL in place. A long
# max-age here means browsers keep serving pre-fix JS/CSS for up to a
# day after a bug is fixed and deployed, with no way to tell except a
# hard refresh. must-revalidate makes the browser check on every load
# instead: cheap (a 304) when nothing changed, instant when it did.
/assets/*
  Cache-Control: public, max-age=0, must-revalidate
/*
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
